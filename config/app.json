{
  "schemaVersion": 1,
  "timezone": "Europe/Moscow",
  "map": {
    "tileProvider": "thunderforest",
    "tileStyle": "transport",
    "corridorBufferMeters": 500,
    "minZoom": 12,
    "maxZoom": 18,
    "overviewMaxZoom": 14,
    "navigationPadding": 0.2,
    "dimmingOpacity": 0.16,
    "diameterColors": { "1": "#ED9F2D", "2": "#DF477C", "3": "#E15D29", "4": "#3CB183" }
  },
  "motion": {
    "anchorField": "departureTime",
    "trainLengthMeters": 160,
    "dwellSeconds": 30,
    "terminalDwellSeconds": 120,
    "fallbackSpeedKmh": 60
  },
  "collector": {
    "baseUrl": "https://mcd.nata-info.ru",
    "build": 84,
    "minRequestIntervalMs": 1000,
    "cyclePauseSeconds": 120,
    "requestTimeoutSeconds": 20,
    "tripMatchWindowSeconds": 1800,
    "historyRetentionHours": 36
  },
  "client": { "snapshotPollIntervalMs": 5000 }
}

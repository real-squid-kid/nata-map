{
  "name": "nata-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-config.mjs",
    "test": "node --test scripts/corridor.test.mjs scripts/motion.test.mjs scripts/train-layout.test.mjs scripts/train-proximity.test.mjs",
    "test:browser": "playwright test",
    "test:server": "php scripts/server.test.php",
    "collect": "php server/collector.php",
    "collect:once": "php server/collector.php --once",
    "server": "php -S 127.0.0.1:8080 -t server server/router.php"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.3"
  }
}
